{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build UE Project",
            "type": "shell",
            "command": "xcodebuild",
            "args": [
                "-workspace",
                "\"${workspaceFolder}/ActionRoguelike (Mac).xcworkspace\"",
                "-scheme",
                "ActionRoguelikeEditor",
                "-configuration",
                "Development"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [
                "$msCompile"
            ]
        }
    ]
}